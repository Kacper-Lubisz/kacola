      },
      "editorial": {
        "$type": "fontFamily",
        "$value": ["Fraunces", "Georgia", "serif"],
        "$description": "italic only: the icon k, empty-state headlines, pull quotes \u2014 sparingly"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"],
        "$description": "timestamps, CLI snippets, shortcuts; tabular numbers"
      }
    }
