{
  "name": "gnomeola",
  "private": true,
  "version": "0.1.0",
  "description": "A GNOME-native meeting recorder and transcriber — inspired by Granola.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p scripts/tsconfig.json && tsc -p brand/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "node scripts/check-boundaries.ts",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests --no-file-parallelism",
    "test:eval": "vitest run --project eval --passWithNoTests --no-file-parallelism",
    "check": "pnpm run boundaries && node scripts/third-party-notices.ts --check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:int",
    "test:mutation": "stryker run stryker.protocol.config.mjs",
    "notices": "node scripts/third-party-notices.ts",
    "brand": "python3 brand/scripts/build.py && node brand/scripts/tokens.ts",
    "brand:tokens": "node brand/scripts/tokens.ts",
    "test:agent-eval": "node packages/e2e/scripts/agent-eval.ts",
    "test:agenda-eval": "node packages/e2e/scripts/agenda-agent-eval.ts",
    "release-gate": "bash scripts/release-gate.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@electron/fuses": "1.8.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
