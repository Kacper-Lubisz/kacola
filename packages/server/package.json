{
  "name": "@kacola/server",
  "version": "0.1.0",
  "private": true,
  "description": "The hosted kacola server (M8): the protocol over the async store, as fetch handlers — pairing auth, hybrid sync, chunked audio, cursor-resumable SSE under a duration cap.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./node": "./src/node.ts"
  },
  "bin": {
    "kacola-server": "./src/bin/serve.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kacola/protocol": "workspace:*",
    "@kacola/store": "workspace:*",
    "@kacola/stt": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@kacola/testkit": "workspace:*",
    "@types/pg": "^8.23.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  }
}
