{
  "name": "@gnomeola/ui",
  "version": "0.1.0",
  "private": true,
  "description": "The GTK4 / libadwaita window, in React via GTKX. Protocol client only.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "codegen": "gtkx codegen",
    "dev": "gtkx dev",
    "build": "NODE_ENV=production gtkx build",
    "start": "node dist/bundle.mjs",
    "typecheck": "gtkx codegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@gnomeola/protocol": "workspace:*",
    "@gtkx/cairo": "1.6.0",
    "@gtkx/css": "1.6.0",
    "@gtkx/native": "1.6.0",
    "@gtkx/react": "1.6.0",
    "@gtkx/runtime": "1.6.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@gtkx/cli": "1.6.0",
    "@gtkx/config": "1.6.0",
    "@types/react": "19.3.0",
    "vite": "8.3.1"
  }
}
