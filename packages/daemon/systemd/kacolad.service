# kacola daemon — systemd *user* unit. Not installed automatically.
#
#   install -Dm644 kacolad.service ~/.config/systemd/user/kacolad.service
#   systemctl --user daemon-reload && systemctl --user enable --now kacolad
#
# Adjust ExecStart to where kacola is installed and to a Node 24+ binary.
[Unit]
Description=kacola meeting recorder daemon
# capture needs the user's PipeWire session
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/env node %h/.local/lib/kacola/packages/daemon/src/main.ts --port 8787
# SIGTERM stops running sessions cleanly (status stopped, audio flushed), closes streams and the DB.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
# The daemon binds loopback only and refuses any other address.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
