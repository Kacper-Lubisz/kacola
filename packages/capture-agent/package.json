{
  "name": "@kacola/capture-agent",
  "version": "0.1.0",
  "private": true,
  "description": "The local-only half (H-2): PipeWire capture with chunked, resumable upload to any kacola server, and the hybrid-sync pusher. Protocol client + capture only.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sync": "./src/sync.ts"
  },
  "bin": {
    "kacola-agent": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kacola/capture": "workspace:*",
    "@kacola/protocol": "workspace:*"
  },
  "devDependencies": {
    "@kacola/server": "workspace:*",
    "@kacola/store": "workspace:*",
    "@kacola/stt": "workspace:*",
    "@kacola/testkit": "workspace:*"
  }
}
