[Desktop Entry]
Type=Application
Name=kacola
Comment=Record, transcribe and search your meetings
Exec=kacola-app %U
MimeType=x-scheme-handler/kacola;
Icon=com.kacperlubisz.Kacola
Terminal=false
Categories=Office;Recorder;
Keywords=meeting;transcript;notes;record;granola;
StartupNotify=true
StartupWMClass=kacola
DBusActivatable=false
X-GNOME-UsesNotifications=true
# the app id before the rename (gnomeola → kacola, 0.2): software centres and launchers carry it over
X-Flatpak-RenamedFrom=org.gnome.Gnomeola.desktop;
Actions=background;

[Desktop Action background]
Name=Start in the Background
Exec=kacola-app --background
